# PluggPress's own backend (ServerPress) -- contact form
VITE_API_URL=http://localhost:5100

# Cry808's backend (Server808) -- powers the Buy Now / Cry808 submission
# flow on /submit-cry808. Must be added to Server808's
# config/siteOrigins.js allowlist for this domain to be allowed to call it.
VITE_CRY808_API_URL=http://localhost:5000

# ArtistHeat's backend (ServerHeat) -- powers the Buy Now / ArtistHeat
# submission flow on /submit-artistheat. Must be added to ServerHeat's
# src/lib/siteOrigins.ts allowlist for this domain to be allowed to call it.
VITE_ARTISTHEAT_API_URL=http://localhost:4100
